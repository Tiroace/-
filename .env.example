# 复制为 .env 后填写；.env 已被 .gitignore 忽略，禁止提交。
# 任何密钥、口令、令牌都不许写进代码、文档或聊天。

# ---- 运行环境 ----
QBL_ENV=dev
QBL_DB_PATH=var/backend/qbl.db
QBL_API_HOST=127.0.0.1
QBL_API_PORT=8000

# ---- 识别引擎 ----
QBL_OCR_BACKEND=rapidocr
QBL_OCR_LIMIT_SIDE_LEN=1000
QBL_OCR_THREADS=8
# 一期不接大模型；只有完成生成式 AI 登记后才允许改 1
QBL_USE_LLM=0
QBL_PATTERN_THRESHOLD=0.35
QBL_PATTERN_REPORT_THRESHOLD=0.5

# ---- 社区（默认关闭，资质核实前不得开启）----
QBL_FEATURE_COMMUNITY=0
QBL_COMMUNITY_NEW_ACCOUNT_HOURS=24
QBL_COMMUNITY_REPORT_HIDE_THRESHOLD=3
QBL_COMMUNITY_APPEAL_SLA_HOURS=24

# ---- 管理员与令牌（本地开发用占位，正式环境必须换）----
QBL_ADMIN_TOKEN=change-me
QBL_JWT_SECRET=change-me

# ---- 平台（正式 AppID/Secret 走安全卡片，不要写这里）----
QBL_WECHAT_APPID=
QBL_WECHAT_SECRET=

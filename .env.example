# 复制为 .env 后填写；.env 已被 .gitignore 忽略，禁止提交。
# 任何密钥、口令、令牌都不许写进代码、文档或聊天。
#
# 变量名必须与 backend/app/config.py 里的读取名一致，改名前先 grep "QBL_"。
# 已知的历史错名（已修正，别再写回去）：
#   QBL_JWT_SECRET     -> 实际是 QBL_TOKEN_SECRET
#   QBL_WECHAT_APPID   -> 实际是 QBL_WX_APPID
#   QBL_WECHAT_SECRET  -> 实际是 QBL_WX_SECRET

# ---- 运行环境 ----
# dev / prod。prod 下若仍用默认口令，服务拒绝启动（见 backend/app/main.py）
QBL_ENV=dev
QBL_DB_PATH=var/backend/qbl.db
QBL_API_HOST=127.0.0.1
QBL_API_PORT=8000
QBL_CACHE_DIR=var/cache
QBL_UPLOAD_DIR=var/uploads
QBL_REPORT_DIR=var/reports
# 截图有效期（小时）：22h TTL + 每小时扫描 ⇒ 从上传到删除 ≤23h，隐私政策承诺 24h 内
QBL_UPLOAD_TTL_HOURS=22

# ---- 识别引擎 ----
QBL_OCR_BACKEND=rapidocr
QBL_OCR_LIMIT_SIDE_LEN=1000
QBL_OCR_THREADS=8
QBL_OCR_MODEL_DIR=
QBL_ENGINE_MODEL=
QBL_WORKER_THREADS=2
QBL_BACKGROUND_AFTER_SECONDS=8
QBL_POLL_AFTER_MS=1000
QBL_FAKE_ENGINE_DELAY_MS=0
# 一期不接大模型；只有完成生成式 AI 登记后才允许改 1
QBL_USE_LLM=0
QBL_PATTERN_THRESHOLD=0.35
QBL_PATTERN_REPORT_THRESHOLD=0.5

# ---- 社区（默认关闭，资质核实前不得开启）----
QBL_FEATURE_COMMUNITY=0
QBL_COMMUNITY_NEW_ACCOUNT_HOURS=24
QBL_COMMUNITY_REPORT_HIDE_THRESHOLD=3
QBL_COMMUNITY_APPEAL_SLA_HOURS=24
QBL_COMMUNITY_POST_MAX_LEN=500
QBL_COMMUNITY_VOTE_WINDOW_MINUTES=10
QBL_COMMUNITY_VOTE_DEVICE_LIMIT=5
QBL_COMMUNITY_VOTE_IP_LIMIT=20

# ---- 额度与订单 ----
QBL_FREE_QUOTA=3
QBL_MEMBER_DAILY_QUOTA=20
QBL_AD_DAILY_CAP=5
QBL_MAX_ORDER_AMOUNT_FEN=30000

# ---- 密钥与口令（token_secret / pay_secret / admin_token）----
# 正式环境走安全卡片注入，不要写进仓库；留空且 QBL_ENV=prod 时服务拒绝启动
QBL_ADMIN_TOKEN=
QBL_TOKEN_SECRET=
QBL_PAY_SECRET=

# ---- 平台（正式 AppID/Secret 走安全卡片，不要写这里）----
QBL_WX_APPID=
QBL_WX_SECRET=
QBL_WX_AD_UNIT_ID=
QBL_TT_APPID=
QBL_TT_SECRET=
QBL_TT_AD_UNIT_ID=

# ---- 开发通道（仅本地联调；prod 下必须为 0）----
QBL_DEV_MODE=0

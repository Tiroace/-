{
  "version": "3.3",
  "pattern_db_version": "2026-10-30",
  "effective_date": "2026-10-31",
  "note": "词库 v3（六维规则 v1）：在 v2 的 26 条基础上，按产品《14-报告模板话术审定表》二之二「真实话术 10 类缺口」新增 24 条规则，覆盖内推承诺/单位点名/异地引流/无薪试岗/多名目收费/租车购车/格式条款/冒名招聘/高薪诱饵/就业歧视。",
  "dimensions": [
    {
      "key": "fee",
      "label": "收费与借贷",
      "order": 1
    },
    {
      "key": "work",
      "label": "工作内容",
      "order": 2
    },
    {
      "key": "title",
      "label": "岗位名称",
      "order": 3
    },
    {
      "key": "pay",
      "label": "薪资待遇",
      "order": 4
    },
    {
      "key": "company",
      "label": "公司信息",
      "order": 5
    },
    {
      "key": "contract",
      "label": "合同社保",
      "order": 6
    }
  ],
  "rules": [
    {
      "rule_id": "R-DEPOSIT-01",
      "type": "scam",
      "dimension": "fee",
      "level": "high",
      "title": "先交押金",
      "hard": true,
      "match": "any",
      "keywords": [
        "押金",
        "保证金",
        "服装费",
        "工服费",
        "工牌费",
        "服装押金",
        "设备押金"
      ],
      "regex": "(交|缴|收取|付|扣|收)\\s*[^。\\n]{0,6}(押金|保证金|服装费|工服费|工牌费)|(押金|保证金|服装费)\\s*[0-9一二三四五六七八九十百千]{1,6}\\s*元",
      "说明": "入职前以任何名义收取押金、保证金、服装费等，违反《劳动合同法》第九条。硬证据，命中即红灯。"
    },
    {
      "rule_id": "R-EXAM-01",
      "type": "scam",
      "dimension": "fee",
      "level": "high",
      "title": "自付体检费",
      "hard": true,
      "match": "any",
      "keywords": [
        "体检费",
        "体检费用",
        "体检押金"
      ],
      "regex": "(交|缴|收取|自理|自付|垫付|先付)\\s*[^。\\n]{0,4}体检费|体检费\\s*[0-9]{2,4}\\s*元",
      "说明": "入职前要求自付体检费是常见收费名目，正规企业一般由公司承担或入职后报销。硬证据。"
    },
    {
      "rule_id": "R-SHABU-01",
      "type": "scam",
      "dimension": "fee",
      "level": "high",
      "title": "刷单返利",
      "hard": true,
      "match": "any",
      "keywords": [
        "刷单",
        "刷信誉",
        "刷好评",
        "刷单返利",
        "点赞返利",
        "助力返利",
        "任务返利"
      ],
      "regex": "(刷单|刷信誉|刷好评)\\s*[^。\\n]{0,10}(佣金|返利|返佣|日结)",
      "说明": "刷单返利本身就是违法行为，且是诈骗最常见入口。硬证据，命中即红灯。"
    },
    {
      "rule_id": "R-ADVANCE-01",
      "type": "scam",
      "dimension": "fee",
      "level": "high",
      "title": "要你先垫钱",
      "hard": true,
      "match": "any",
      "keywords": [
        "垫付",
        "先垫资",
        "垫资",
        "垫货款"
      ],
      "regex": "(先|需|要求|自行)\\s*[^。\\n]{0,4}垫付",
      "说明": "要求求职者先垫付货款/保证金再返还，是典型诈骗话术。硬证据。"
    },
    {
      "rule_id": "R-BANK-01",
      "type": "scam",
      "dimension": "fee",
      "level": "high",
      "title": "索要银行卡",
      "hard": true,
      "match": "any",
      "keywords": [
        "短信验证码",
        "银行卡号",
        "手持身份证",
        "身份证正反面",
        "银行卡密码"
      ],
      "regex": "(提供|填写|发送|上传|告知|核对)\\s*[^。\\n]{0,8}(银行卡|身份证|验证码|支付密码)",
      "说明": "索要银行卡号、验证码、身份证影像，可能用于盗刷或办贷。硬证据。"
    },
    {
      "rule_id": "R-PAYFIRST-01",
      "type": "scam",
      "dimension": "fee",
      "level": "high",
      "title": "入职前收钱",
      "hard": true,
      "match": "any",
      "keywords": [],
      "regex": "入职前\\s*[^。\\n]{0,8}(交|缴|付|收取)|先\\s*(交|缴|付)\\s*[^。\\n]{0,4}(钱|费|元)",
      "说明": "入职前先收钱，无论名目是什么都违反《劳动合同法》第九条。硬证据。"
    },
    {
      "rule_id": "R-TRAIN-02",
      "type": "train_loan",
      "dimension": "fee",
      "level": "high",
      "title": "收培训费",
      "hard": true,
      "match": "any",
      "keywords": [
        "培训费",
        "培训费用",
        "培训押金",
        "课程费",
        "学费"
      ],
      "regex": "(交|缴|收取|付|需)\\s*[^。\\n]{0,6}(培训费|课程费|学费)",
      "说明": "向求职者收取培训费，是招转培的核心收费点。硬证据，命中即红灯。"
    },
    {
      "rule_id": "R-LOAN-01",
      "type": "train_loan",
      "dimension": "fee",
      "level": "high",
      "title": "诱导办贷款",
      "hard": true,
      "match": "any",
      "keywords": [
        "培训贷",
        "助学贷",
        "先学后付",
        "分期付款",
        "分期协议"
      ],
      "regex": "(办理|申请|签订|签署|要求|可以)\\s*[^。\\n]{0,8}(贷款|分期|助学贷)|(贷款|学费)\\s*[^。\\n]{0,6}(培训|分期)|培训贷",
      "说明": "以招聘为名要求办贷款/分期付学费，是最危险的培训贷形态，可能直接影响征信。硬证据。"
    },
    {
      "rule_id": "R-OVERSEAS-01",
      "type": "scam",
      "dimension": "pay",
      "level": "high",
      "title": "境外高薪",
      "hard": true,
      "match": "any",
      "keywords": [
        "境外高薪",
        "国外高薪",
        "海外直招",
        "包机票",
        "包往返机票"
      ],
      "regex": "(境外|国外|海外|缅北|柬埔寨|老挝|迪拜|东南亚)\\s*[^。\\n]{0,10}(高薪|月薪|年薪|工作|上班|直招)|(包|报销)\\s*[^。\\n]{0,4}(机票|路费)",
      "说明": "境外高薪+包机票是跨境招工陷阱的典型组合，人身安全风险极高。硬证据。"
    },
    {
      "rule_id": "R-APP-01",
      "type": "scam",
      "dimension": "work",
      "level": "high",
      "title": "让你下App进群",
      "hard": true,
      "match": "any",
      "keywords": [
        "下载APP",
        "下载App",
        "下载软件",
        "下载客户端"
      ],
      "regex": "(下载|安装|注册)\\s*[^。\\n]{0,10}(APP|App|app|软件|客户端)|(加|进|加入)\\s*[^。\\n]{0,6}(QQ群|qq群|微信群|群聊)|(加|添加)\\s*[^。\\n]{0,6}(客服|老师|导师|助理)\\s*[^。\\n]{0,6}(微信|QQ|qq)",
      "说明": "要求下载陌生 App、进群或加客服微信，是脱离招聘平台监管的常见手法。硬证据（§4.2 明列「下载 App」）。"
    },
    {
      "rule_id": "R-INJECT-01",
      "type": "scam",
      "dimension": "work",
      "level": "warn",
      "title": "有干扰指令",
      "hard": false,
      "match": "regex",
      "keywords": [],
      "regex": "(忽略|无视|跳过)\\s*[^。\\n]{0,12}(以上|之前|上述|前面)\\s*[^。\\n]{0,12}(要求|指令|提示|内容)|(直接|一律)\\s*[^。\\n]{0,6}(判定|输出|结论)\\s*[^。\\n]{0,6}(安全|正常)",
      "说明": "截图里出现试图干扰判断的指令性文字（提示词注入）。按红线只当普通文字分析，不执行，同时作为可疑信号提示。"
    },
    {
      "rule_id": "R-TITLE-01",
      "type": "bait_switch",
      "dimension": "title",
      "level": "warn",
      "title": "名头对不上",
      "hard": false,
      "match": "regex",
      "keywords": [
        "推送至",
        "推送不符",
        "虚构",
        "严重不符"
      ],
      "regex": "(储备干部|管培生|管理培训生|行政助理|客服专员|人事助理|运营助理|市场专员)[\\s\\S]{0,40}(电话销售|地推|发单页|扫楼|保险代理|直播带货|拉新|推销)|(电话销售|地推|保险代理)[\\s\\S]{0,40}(储备干部|管培生|行政助理|市场专员)",
      "说明": "岗位名称与实际职责对不上：挂着管理/文职名头，实际是销售、地推、保险代理。"
    },
    {
      "rule_id": "R-TITLE-02",
      "type": "bait_switch",
      "dimension": "title",
      "level": "warn",
      "title": "岗位名很虚",
      "hard": false,
      "match": "any",
      "keywords": [
        "急招",
        "大量招",
        "包分配",
        "无需经验高薪"
      ],
      "regex": "(储备干部|管培生|管理培训生)\\s*[^。\\n]{0,6}(急招|大量|包分配)|(急招|大量招)\\s*[^。\\n]{0,6}(客服|助理|专员)",
      "说明": "岗位名称空泛、职责不写清，实际工作内容容易与宣传不符。"
    },
    {
      "rule_id": "R-SALARY-01",
      "type": "exaggerate",
      "dimension": "pay",
      "level": "notice",
      "title": "薪资跨度大",
      "hard": false,
      "match": "regex",
      "keywords": [
        "月工资8000元至12000元"
      ],
      "regex": "([0-9]{1,2})\\s*[kK千万]\\s*[-~—–至到]\\s*([0-9]{1,2})\\s*[kK千万]",
      "check": "salary_span",
      "说明": "薪资区间跨度超过 3 倍（如 5k-30k），大概率是拿最高值画饼，实际底薪很低。"
    },
    {
      "rule_id": "R-UPTO-01",
      "type": "exaggerate",
      "dimension": "pay",
      "level": "notice",
      "title": "上不封顶",
      "hard": false,
      "match": "any",
      "keywords": [
        "上不封顶",
        "月入过万",
        "轻松月入",
        "躺赚",
        "钱多事少",
        "日入过千",
        "月薪上万不是梦"
      ],
      "regex": "努力\\s*[^。\\n]{0,6}(月入|收入|过万)",
      "说明": "「上不封顶」「轻松月入过万」这类无上限承诺无法核实，属于夸大宣传。"
    },
    {
      "rule_id": "R-VAGUE-01",
      "type": "exaggerate",
      "dimension": "pay",
      "level": "notice",
      "title": "薪资写得糊",
      "hard": false,
      "match": "any",
      "keywords": [
        "综合薪资",
        "薪资面议"
      ],
      "regex": "(五险一金|社保|公积金)\\s*[^。\\n]{0,8}(按国家规定|转正后|视情况|再议|再说)",
      "说明": "福利写得模糊（综合薪资、转正后才缴、按国家规定），实际待遇要当面问清。"
    },
    {
      "rule_id": "R-WORK-01",
      "type": "bait_switch",
      "dimension": "work",
      "level": "warn",
      "title": "职责写不清",
      "hard": false,
      "match": "any",
      "keywords": [
        "工作轻松",
        "具体面谈",
        "到岗再定",
        "听从安排"
      ],
      "regex": "(推送|安排)\\s*[^。\\n]{0,8}(严重不符|不符|与描述)|(工作内容|岗位职责)\\s*[^。\\n]{0,4}(面谈|面议|再定|听安排)|虚构\\s*[^。\\n]{0,6}岗位",
      "说明": "工作内容不写清楚、只说到岗再定，容易在实际工作中被安排销售、地推等岗位。"
    },
    {
      "rule_id": "R-COMPANY-01",
      "type": "scam",
      "dimension": "company",
      "level": "warn",
      "title": "公司没写全",
      "hard": false,
      "match": "any",
      "keywords": [
        "大公司直招",
        "知名企业直招",
        "集团直招",
        "频繁变更面试地点",
        "变更面试地点"
      ],
      "regex": "(公司名称|公司地址)\\s*[^。\\n]{0,4}(面议|面谈|再定|保密)|(大公司|知名企业|集团)\\s*[^。\\n]{0,4}直招",
      "说明": "不写公司全称和地址、只说是大公司直招，无法核实主体，风险较高。"
    },
    {
      "rule_id": "R-PROBATION-01",
      "type": "illegal_clause",
      "dimension": "contract",
      "level": "warn",
      "title": "试用期超限",
      "hard": false,
      "match": "regex",
      "keywords": [],
      "regex": "试用期\\s*([0-9一二三四五六七八九十]{1,2})\\s*个?月",
      "check": "probation_over",
      "说明": "试用期超过法定上限（《劳动合同法》第十九条：合同 3 个月–1 年最长 1 个月，1–3 年最长 2 个月，3 年以上最长 6 个月）。"
    },
    {
      "rule_id": "R-NOSOCIAL-01",
      "type": "illegal_clause",
      "dimension": "contract",
      "level": "warn",
      "title": "试用期不缴社保",
      "hard": false,
      "match": "any",
      "keywords": [
        "不缴社保",
        "不交社保",
        "无社保",
        "没有社保",
        "未签订书面劳动合同",
        "不签书面合同"
      ],
      "regex": "(试用期|转正前|实习期)\\s*[^。\\n]{0,10}(不缴|不交|不买|暂不|没有)\\s*[^。\\n]{0,4}(社保|五险|公积金)",
      "说明": "试用期不缴社保违法，社保应从用工之日起缴纳。"
    },
    {
      "rule_id": "R-IDHOLD-01",
      "type": "illegal_clause",
      "dimension": "contract",
      "level": "warn",
      "title": "要扣证件",
      "hard": false,
      "match": "any",
      "keywords": [
        "扣押身份证",
        "押身份证",
        "扣留身份证",
        "上交毕业证",
        "上交身份证"
      ],
      "regex": "(扣押|扣留|上交|抵押|押)\\s*[^。\\n]{0,4}(身份证|毕业证|学位证|证件|户口本)",
      "说明": "扣押证件违反《劳动合同法》第九条，用人单位不得扣押劳动者证件。"
    },
    {
      "rule_id": "R-DISCRIM-01",
      "type": "illegal_clause",
      "dimension": "title",
      "level": "notice",
      "title": "疑似歧视",
      "hard": false,
      "match": "any",
      "keywords": [
        "限男性",
        "限女性",
        "仅限男性",
        "仅限女性",
        "只招男生",
        "只招女生",
        "已婚已育",
        "不招女性",
        "不招男性"
      ],
      "regex": "(本地户口|本市户口|城镇户口)\\s*[^。\\n]{0,4}(优先|要求|必须|限定)",
      "说明": "性别、婚育、地域限制涉嫌就业歧视。"
    },
    {
      "rule_id": "R-GREEN-COMPANY-01",
      "type": "normal",
      "dimension": "company",
      "level": "green",
      "title": "公司写得全",
      "hard": false,
      "match": "any",
      "keywords": [
        "有限公司",
        "股份有限公司"
      ],
      "regex": "(公司名称|公司地址)\\s*[:：]",
      "说明": "截图里写了公司全称或明确地址，公司主体可核实。绿灯证据。"
    },
    {
      "rule_id": "R-GREEN-PAY-01",
      "type": "normal",
      "dimension": "pay",
      "level": "green",
      "title": "薪资写清楚",
      "hard": false,
      "match": "any",
      "keywords": [
        "底薪",
        "五险一金",
        "税前",
        "到手"
      ],
      "regex": "(薪资|月薪|工资)\\s*[:：]\\s*[0-9]{4,6}\\s*[-~至到]?\\s*[0-9]{0,6}\\s*元",
      "说明": "薪资区间/结构写得具体，不属于模糊承诺。绿灯证据。"
    },
    {
      "rule_id": "R-GREEN-CONTRACT-01",
      "type": "normal",
      "dimension": "contract",
      "level": "green",
      "title": "社保说清楚",
      "hard": false,
      "match": "any",
      "keywords": [

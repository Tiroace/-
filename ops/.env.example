# ops/ 部署用环境变量清单
# 用法：复制本项目根目录的 .env.example 或本文件为 ops/.env，再填本地值。
# 规则：.env 已被 .gitignore 忽略（`*.env`、`.env`、`.env.*`），禁止提交、禁止贴进群聊。
#      仓库里只允许出现本文件（.env.example）。

# ================= 容器镜像 =================
# MySQL 8.4 LTS / Redis 7.4：均为官方镜像，生产用固定小版本号（补丁升级可控）
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4

# ================= 数据库（MySQL 8）=================
# 生产环境必须换成随机强口令（≥24 位，大小写+数字+符号）；本地联调可用占位值
MYSQL_DATABASE=qbl
MYSQL_USER=qbl
MYSQL_PASSWORD=change-me-local-only
MYSQL_ROOT_PASSWORD=change-me-root-local-only

# ================= Redis =================
# 本地不设口令；生产必须开启（见 ops/安全基线.md「Redis 不得裸露」）
REDIS_PASSWORD=

# ================= 应用运行时 =================
QBL_ENV=dev
# 容器内固定挂 /data（由 docker-compose.yml 设置），这里仅作说明，不需要改
# QBL_DB_PATH=/data/qbl.db
QBL_API_HOST=0.0.0.0
QBL_API_PORT=8000

# ================= 识别引擎 =================
QBL_OCR_BACKEND=rapidocr
QBL_OCR_LIMIT_SIDE_LEN=1000
QBL_OCR_THREADS=4
# 一期不接大模型；只有完成生成式 AI 登记后才允许改 1（D19 路线调整令）
QBL_USE_LLM=0
QBL_PATTERN_THRESHOLD=0.35
QBL_PATTERN_REPORT_THRESHOLD=0.5
# 后台分析线程数与单图超时（生产按机器核数调，见 ops/上线方案.md「机型选型」）
QBL_WORKER_THREADS=4

# ================= 社区（默认关闭）=================
# D14：资质核实前不得开启，保持 0
QBL_FEATURE_COMMUNITY=0

# ================= 管理员与令牌 =================
# 后端鉴权头：X-Admin-Token（原型期）。生产必须换成长随机串，走安全卡片注入。
QBL_ADMIN_TOKEN=change-me-local-only
QBL_TOKEN_SECRET=change-me-local-only
QBL_PAY_SECRET=change-me-local-only

# ================= 平台凭据 =================
# 正式 AppID/Secret 不进任何文件，只在部署时用安全卡片/密钥管理注入
QBL_WX_APPID=
QBL_WX_SECRET=
